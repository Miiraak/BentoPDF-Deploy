# =============================================================================
# .dockerignore — BentoPDF-Deploy
#
# Exclut du contexte de build Docker les fichiers inutiles ou sensibles.
# Le contexte inclut le Dockerfile, nginx/, wasm/ et branding/.
# =============================================================================

# Contrôle de version
.git
.gitignore
.gitattributes
.gitkeep

# Documentation (non nécessaire dans l'image)
README.md
docs/
*.md

# Certificats TLS — JAMAIS intégrés dans une image.
# Ils sont montés en volume au runtime via docker-compose.
certs/

# Contrôles locaux et workflows (non nécessaires dans l'image)
.github/
tests/
scripts/

# IDE / éditeur
.vscode/
.idea/
*.swp
*.swo
*.orig

# Artefacts OS
.DS_Store
Thumbs.db

# Fichiers temporaires
tmp/
